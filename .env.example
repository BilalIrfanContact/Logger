# Public Supabase values are safe to expose to the browser. Never put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Required for manual account deletion; never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional in development. Production OAuth and email links should use the deployed origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
